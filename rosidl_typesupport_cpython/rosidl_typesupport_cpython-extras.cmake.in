# generated from
# rosidl_typesupport_cpython/rosidl_typesupport_cpython-extras.cmake.in

# use the same type of library
set(rosidl_typesupport_cpython_LIBRARY_TYPE "@rosidl_typesupport_cpython_LIBRARY_TYPE@")

find_package(rosidl_typesupport_c QUIET REQUIRED)
get_used_typesupports(_typesupports "rosidl_typesupport_cpython")

# Make sure extension points are registered in order
find_package(rosidl_generator_cpp QUIET)
foreach(_typesupport ${_typesupports})
  find_package(${_typesupport} QUIET)
endforeach()

find_package(ament_cmake_core QUIET REQUIRED)
ament_register_extension(
  "rosidl_generate_idl_interfaces"
  "rosidl_typesupport_cpython"
  "rosidl_typesupport_cpython_generate_interfaces.cmake")

set(rosidl_typesupport_cpython_BIN
  "${rosidl_typesupport_cpython_DIR}/../../../lib/rosidl_typesupport_cpython/rosidl_typesupport_cpython")
normalize_path(rosidl_typesupport_cpython_BIN
  "${rosidl_typesupport_cpython_BIN}")

set(rosidl_typesupport_cpython_GENERATOR_FILES
  "${rosidl_typesupport_cpython_DIR}/../../../@PYTHON_INSTALL_DIR@/rosidl_typesupport_cpython/__init__.py")
normalize_path(rosidl_typesupport_cpython_GENERATOR_FILES
  "${rosidl_typesupport_cpython_GENERATOR_FILES}")

set(rosidl_typesupport_cpython_TEMPLATE_DIR
  "${rosidl_typesupport_cpython_DIR}/../resource")
normalize_path(rosidl_typesupport_cpython_TEMPLATE_DIR
  "${rosidl_typesupport_cpython_TEMPLATE_DIR}")
