<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rosidl_typesupport_introspection_cpython</name>
  <version>0.1.0</version>
  <description>
    Generate the C-based introspection type support (rosidl_typesupport_introspection_c
    MessageMembers) for ROS 2 experimental Python messages.  The generated
    descriptors describe the Python experimental message classes (containers
    from rosidl_runtime_cpython) so middleware can build XTypes TypeObjects for
    cross-process discovery without knowing the Python layout.  Function
    pointers are implemented with pybind11, treating void * as a type-erased
    PyObject *.
  </description>
  <maintainer email="miguel@example.com">Miguel Company</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>rosidl_cmake</build_depend>
  <build_depend>rosidl_pycommon</build_depend>

  <depend>pybind11_vendor</depend>
  <depend>rosidl_cli</depend>
  <depend>rosidl_parser</depend>
  <depend>rosidl_runtime_c</depend>
  <depend>rosidl_typesupport_interface</depend>
  <depend>rosidl_typesupport_introspection_c</depend>

  <buildtool_export_depend>ament_cmake</buildtool_export_depend>
  <buildtool_export_depend>rosidl_cmake</buildtool_export_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_pycommon</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <member_of_group>rosidl_typesupport_cpython_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
